GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Pool de contas Cloudinary com troca automática ao atingir 95% de uso.
# Ordem de prioridade: CLOUDINARY_URL (principal/nova) -> CLOUDINARY_URL_2 (reserva) -> _3 ...
# Enquanto a conta principal estiver < 95%, ela é sempre usada; ao chegar a 95%
# o sistema migra sozinho para a próxima conta livre.
CLOUDINARY_URL=
CLOUDINARY_URL_2=
# (opcional) Alternativa: várias URLs em uma só variável, separadas por vírgula.
# CLOUDINARY_URLS=cloudinary://key:secret@cloudA,cloudinary://key:secret@cloudB
CLOUDINARY_FOLDER=abastecimentos
