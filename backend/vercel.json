{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "crons": [
    {
      "path": "/relatorio-semanal/enviar",
      "schedule": "0 10 * * 1"
    },
    {
      "path": "/atua/enviar",
      "schedule": "0 4 * * *"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
